<?xml version="1.0" encoding="UTF-8"?>
<connections>
    <!-- From NORTH (travelling south): straight → south_out, right → west_out -->
    <connection from="north_in" to="south_out" fromLane="0" toLane="0" dir="s"/>
    <connection from="north_in" to="south_out" fromLane="1" toLane="1" dir="s"/>
    <connection from="north_in" to="west_out"  fromLane="0" toLane="0" dir="r"/>

    <!-- From SOUTH (travelling north): straight → north_out, right → east_out -->
    <connection from="south_in" to="north_out" fromLane="0" toLane="0" dir="s"/>
    <connection from="south_in" to="north_out" fromLane="1" toLane="1" dir="s"/>
    <connection from="south_in" to="east_out"  fromLane="0" toLane="0" dir="r"/>

    <!-- From EAST (travelling west): straight → west_out, right → north_out -->
    <connection from="east_in"  to="west_out"  fromLane="0" toLane="0" dir="s"/>
    <connection from="east_in"  to="west_out"  fromLane="1" toLane="1" dir="s"/>
    <connection from="east_in"  to="north_out" fromLane="0" toLane="0" dir="r"/>

    <!-- From WEST (travelling east): straight → east_out, right → south_out -->
    <connection from="west_in"  to="east_out"  fromLane="0" toLane="0" dir="s"/>
    <connection from="west_in"  to="east_out"  fromLane="1" toLane="1" dir="s"/>
    <connection from="west_in"  to="south_out" fromLane="0" toLane="0" dir="r"/>
</connections>
